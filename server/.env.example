# Switchboard Server Environment Variables (Example)
# Copy this file to .env and fill in real secrets before running.

PORT=3001
NODE_ENV=development

# 32+ random characters for JWT signing
JWT_SECRET=change_me_to_a_secure_random_secret_string_at_least_32_chars

# 64-hex-character key for AES-256-GCM credential vault encryption
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database connection string (SQLite file path for local dev, or Supabase PostgreSQL URL for production)
# For local SQLite: data/switchboard.db
# For Supabase PostgreSQL: postgres://postgres.xxx:yyy@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=data/switchboard.db

# CORS allowed origins (comma-separated for production)
CORS_ORIGIN=http://localhost:5173
